# El stack local no necesita ninguna de estas variables: `lib/db/url.ts` ya trae los valores
# del Supabase local, que son públicos e iguales en cualquier máquina. Copiá este archivo a
# `.env.local` solo si querés apuntar a otra base.

# Connection string de Postgres. La de tests se deriva de esta cambiándole el nombre de la
# base, no se configura aparte.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
